# ---- Backend ----
# Postgres (Supabase) connection string, e.g.:
# postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Leave unset to use a local SQLite file (signalwatch.db) for zero-config dev.
DATABASE_URL=

# Market data provider (Twelve Data: https://twelvedata.com/pricing -- free
# tier is enough for this app). Leave unset to run in DEMO_MODE instead.
TWELVE_DATA_API_KEY=

# Set to true to force synthetic/demo market data even if an API key is
# present. Automatically on (no need to set this) whenever
# TWELVE_DATA_API_KEY is empty, so the app is runnable out of the box.
DEMO_MODE=false

# ---- Frontend ----
# URL of the deployed (or local) FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
